# 3. Jenkins CI/CD: https://jenkins.ezhilselvan.tech
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name jenkins.ezhilselvan.tech;

    ssl_certificate /etc/letsencrypt/live/ezhilselvan.tech/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ezhilselvan.tech/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        set $jenkins_backend http://jenkins:8080;
        proxy_pass $jenkins_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
        proxy_request_buffering off;
        client_max_body_size 50M;
    }
}

