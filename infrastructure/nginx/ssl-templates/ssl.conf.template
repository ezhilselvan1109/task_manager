# =========================================================================
# Task Management Platform - Hardened TLS 1.2/1.3 HTTPS Virtual Hosts
# Uses dynamic Docker DNS resolution (127.0.0.11 valid=10s) to prevent stale 502s.
# =========================================================================

# 1. Primary Web App: https://ezhilselvan.tech, https://www.ezhilselvan.tech, https://app.ezhilselvan.tech
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ezhilselvan.tech www.ezhilselvan.tech app.ezhilselvan.tech;

    ssl_certificate /etc/letsencrypt/live/ezhilselvan.tech/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ezhilselvan.tech/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location /healthz {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    location /api/ {
        set $gateway_backend http://api-gateway:8080;
        proxy_pass $gateway_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Correlation-ID $http_x_correlation_id;
        client_max_body_size 10M;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location / {
        set $frontend_backend http://frontend:80;
        proxy_pass $frontend_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

# 2. API Gateway: https://api.ezhilselvan.tech
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name api.ezhilselvan.tech;

    ssl_certificate /etc/letsencrypt/live/ezhilselvan.tech/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ezhilselvan.tech/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = / {
        default_type application/json;
        return 200 '{"service":"Task Manager API Gateway","status":"UP","health":"/actuator/health","endpoints":["/api/v1/auth/register","/api/v1/auth/login","/api/v1/users/me","/api/v1/tasks","/api/v1/notifications"]}';
    }

    location / {
        set $gateway_backend http://api-gateway:8080;
        proxy_pass $gateway_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Correlation-ID $http_x_correlation_id;
        client_max_body_size 10M;
    }
}

# 3. Jenkins CI/CD: https://jenkins.ezhilselvan.tech
