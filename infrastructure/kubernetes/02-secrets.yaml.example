# Template only - NEVER commit real secrets to Git!
# On the VPS, create the secret directly from .env:
#   kubectl -n taskmanager create secret generic taskmanager-secrets --from-env-file=/opt/taskmanager/.env
apiVersion: v1
kind: Secret
metadata:
  name: taskmanager-secrets
  namespace: taskmanager
type: Opaque
stringData:
  MYSQL_ROOT_PASSWORD: "REPLACE_ME"
  DB_USER_PASSWORD: "REPLACE_ME"
  DB_TASK_PASSWORD: "REPLACE_ME"
  DB_NOTIF_PASSWORD: "REPLACE_ME"
  JWT_SECRET: "REPLACE_ME"
