# =========================================================================
# Task Management Platform - Production Environment Variables Template
# Target: Hostinger VPS (Ubuntu 26.04 LTS, 4 vCPU, 16 GB RAM, 200 GB NVMe)
# 
# Instructions:
# 1. Copy this template to .env on your VPS:
#    cp .env.example .env
# 2. Generate strong, cryptographically secure random values:
#    - For passwords:  openssl rand -base64 24
#    - For JWT secret: openssl rand -base64 48
# 3. Secure file permissions:
#    chmod 600 .env
# =========================================================================

# -------------------------------------------------------------------------
# 1. Spring Profile & Environment Execution Mode
# -------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=docker

# -------------------------------------------------------------------------
# 2. PostgreSQL Master Credentials & Service DB Passwords
# Used by: postgresql (init-multi-db.sh), user-service, task-service, notification-service
# -------------------------------------------------------------------------
POSTGRES_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_MIN_24_CHARS
POSTGRES_HOST_PORT=5432

# Dedicated user passwords created during PostgreSQL container initialization
DB_USER_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_FOR_USER_APP
DB_TASK_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_FOR_TASK_APP
DB_NOTIF_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_FOR_NOTIF_APP

# -------------------------------------------------------------------------
# 3. JWT Security & Token Signing
# Used by: api-gateway, user-service
# Must be at least 256 bits (32 bytes) Base64-encoded for HMAC-SHA256 (HS256)
# Generate command: openssl rand -base64 48
# -------------------------------------------------------------------------
JWT_SECRET=REPLACE_WITH_BASE64_256_BIT_KEY_MINIMUM_48_CHARS

# -------------------------------------------------------------------------
# 4. Observability & Monitoring Settings
# Used by: grafana, prometheus, service-discovery
# -------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_GRAFANA_ADMIN_PASSWORD
GRAFANA_HOST_PORT=3001
PROMETHEUS_HOST_PORT=9090
EUREKA_HOST_PORT=8761

# -------------------------------------------------------------------------
# 5. Frontend SPA & Edge Reverse Proxy Settings
# Used by: frontend (build-arg), nginx reverse proxy
# Default empty string enables relative same-origin /api/... calls via Nginx
# -------------------------------------------------------------------------
DOMAIN_NAME=yourdomain.com
FRONTEND_API_BASE_URL=

